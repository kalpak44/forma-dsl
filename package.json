{
  "name": "forma-dsl-workspace",
  "private": true,
  "description": "Monorepo for the forma-dsl library, its editor and its documentation.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev -w @forma-dsl/editor",
    "build": "npm run build -w @forma-dsl/editor && npm run build -w @forma-dsl/docs",
    "build:docs": "npm run build -w @forma-dsl/docs",
    "preview": "npm run preview -w @forma-dsl/editor",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage -w forma-dsl",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w forma-dsl",
    "check:package": "npm run check:package -w forma-dsl",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^17.12.0"
  }
}
