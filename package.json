{
  "name": "forma-dsl",
  "version": "0.1.0",
  "description": "A declarative DSL for 3D modeling and scene composition, reusable components, and live previews.",
  "keywords": [
    "cad",
    "csg",
    "3d",
    "dsl",
    "parametric",
    "manifold",
    "stl",
    "geometry",
    "webassembly"
  ],
  "homepage": "https://github.com/kalpak44/forma-dsl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalpak44/forma-dsl.git"
  },
  "bugs": {
    "url": "https://github.com/kalpak44/forma-dsl/issues"
  },
  "author": "Pavel Usanli",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.src.json",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:package",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "manifold-3d": "^3.5.4"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^17.12.0",
    "three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
